---
import keywords from '../content/keywords.json'
import notes from '../content/notes.json'
import books from '../content/books.json'
import '../styles/global.css'

const noteFor = (id) => notes.find((n) => n.keywordId === id)
const base = import.meta.env.BASE_URL
const catOrder = ['Linux 内核', '网络', '代理', 'Kubernetes', '语言']
const rank = (cat) => (catOrder.indexOf(cat) === -1 ? 99 : catOrder.indexOf(cat))
const ordered = [...keywords].sort(
  (a, b) => rank(a.category) - rank(b.category) || keywords.indexOf(a) - keywords.indexOf(b)
)
const clusters = catOrder
  .map((cat) => ({ cat, items: ordered.filter((k) => k.category === cat) }))
  .filter((c) => c.items.length)

// 每本书 → 第一个引用它的关键词(让书单与知识网连通)
const bookRef = {}
for (const k of ordered) {
  const note = noteFor(k.id)
  for (const b of note?.books || []) if (!(b.id in bookRef)) bookRef[b.id] = k.id
}

const statusOrder = ['reading', 'done', 'recommended']
const statusLabel = { reading: '在读', done: '已读', recommended: '待读' }
const statusClass = { reading: 'bstatus--reading', done: 'bstatus--done', recommended: 'bstatus--to-read' }
const shelfBooks = [...books].sort(
  (a, b) => statusOrder.indexOf(a.status) - statusOrder.indexOf(b.status)
)
const total = keywords.length
const shelfCount = shelfBooks.length
const readingCount = books.filter((b) => b.status === 'reading').length
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <meta name="description" content="Knowledge Atlas——每个关键词一篇像人写的深度笔记:从背景、原理到原理的原理,再到能落地的命令与坑。" />
    <meta property="og:title" content="Knowledge Atlas — 关键词笔记" />
    <meta property="og:description" content="一个关键词,一篇文章。12 个主题,每篇从背景讲到能落地的命令与坑。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://zoeimport.github.io${base}`} />
    <link rel="canonical" href={`https://zoeimport.github.io${base}`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>Knowledge Atlas — 关键词笔记</title>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-shell">
        <a class="wordmark" href={`${base}`}>Atlas<span>.</span></a>
        <nav class="primary-nav" aria-label="主导航">
          <a href={`${base}`} aria-current="page">Atlas</a>
          <a href="https://zoeimport.github.io/">主站</a>
          <a href="https://github.com/ZoeImport" rel="me">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <div class="page-shell">
      <section class="atlas-intro">
        <span class="eyebrow">Knowledge Atlas</span>
        <h1>一个关键词，一篇文章。</h1>
        <p class="lede">
          {total} 个主题，每个主题一篇像人写的深度笔记——从背景、原理到原理的原理，再到能落地的命令与坑。按分类从上往下读，或按 <kbd>⌘K</kbd> 过滤。
        </p>
      </section>

      <div class="filter-row">
        <input id="filter" type="search" placeholder="过滤关键词、子词…" autocomplete="off" aria-label="站内过滤" />
        <span class="filter-hint">⌘K</span>
        <span id="filter-count" class="filter-count" aria-live="polite"></span>
      </div>
      <p id="search-empty" class="search-empty" hidden>没有匹配的结果，换个词试试。</p>

      {clusters.map((c) => (
        <section class="cluster" data-cluster>
          <div class="cluster-head">
            <h2>{c.cat}</h2>
            <span class="count">{c.items.length} 个关键词</span>
          </div>
          {c.items.map((k, i) => {
            const note = noteFor(k.id)
            const search = [k.title, k.category, k.summary, ...k.tags, ...(note ? note.subTopics.map((s) => s.name) : [])].join(' ')
            const num = String(i + 1).padStart(2, '0')
            return (
              <a class="krow" href={`${base}keywords/${k.id}/`} data-search={search}>
                <span class="idx">{num}</span>
                <span class="kbody">
                  <h3 class="ktitle">{k.title}</h3>
                  <p class="ksum">{k.summary}</p>
                </span>
                <span class="ktags">
                  {k.tags.slice(0, 3).map((t) => <span>{t}</span>)}
                </span>
              </a>
            )
          })}
        </section>
      ))}

      <section class="shelf">
        <div class="shelf-head">
          <h2>书单</h2>
          <span class="count">{shelfCount} 本 · {readingCount} 在读</span>
        </div>
        {shelfBooks.map((b) => {
          const ref = bookRef[b.id]
          const cls = statusClass[b.status] || ''
          const inner = (
            <>
              <span class={`bstatus ${cls}`}>{statusLabel[b.status] || b.status}</span>
              <span class="kbody">
                <span class="btitle">{b.title}</span>
                <p class="bdetail">{b.progress || b.detail}</p>
              </span>
              <span class="bnote">{ref ? '↗ 关键词' : ''}</span>
            </>
          )
          return ref ? (
            <a class="bookrow" href={`${base}keywords/${ref}/`}>{inner}</a>
          ) : (
            <div class="bookrow">{inner}</div>
          )
        })}
      </section>
    </div>

    <footer class="site-footer">
      <div class="footer-shell">
        <div>
          <p class="footer-title">读深一点，再读深一点。</p>
          <p class="footer-copy">Knowledge Atlas · 关键词与笔记 · 持续生长中</p>
        </div>
        <nav class="footer-links" aria-label="页脚导航">
          <a href={`${base}`}>Atlas</a>
          <a href="https://zoeimport.github.io/">主站</a>
          <a href="https://github.com/ZoeImport" rel="me">GitHub ↗</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      // 过滤:按行隐藏,不做 innerHTML 重写(XSS 安全);cluster 内全部隐藏时整块收起
      (() => {
        const box = document.getElementById('filter')
        const count = document.getElementById('filter-count')
        const empty = document.getElementById('search-empty')
        const clusters = Array.from(document.querySelectorAll('.cluster'))
        const run = () => {
          const q = box.value.trim().toLowerCase()
          let shown = 0
          for (const cl of clusters) {
            let vis = 0
            cl.querySelectorAll('.krow').forEach((r) => {
              const hit = !q || r.dataset.search.toLowerCase().includes(q)
              r.style.display = hit ? '' : 'none'
              if (hit) vis++
            })
            cl.style.display = vis ? '' : 'none'
            shown += vis
          }
          empty.hidden = !(q && shown === 0)
          count.textContent = q ? `${shown} / ${clusters.reduce((n, c) => n + c.querySelectorAll('.krow').length, 0)}` : ''
        }
        box.addEventListener('input', run)
        document.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); box.focus() }
        })
      })()
    </script>
  </body>
</html>
