---
import keywords from '../content/keywords.json'
import notes from '../content/notes.json'
import books from '../content/books.json'
import '../styles/global.css'

const categories = [...new Set(keywords.map((k) => k.category))]
const noteFor = (id) => notes.find((n) => n.keywordId === id)
const base = import.meta.env.BASE_URL
const catIcon = { 'Linux 内核': '🐧', '网络': '🌐', '代理': '🔀', 'Kubernetes': '☸️', '语言': '🧬' }
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <title>Knowledge Atlas — 关键词与笔记</title>
    <meta name="description" content="独立知识站：每个关键词都有一篇像人写的文章，从背景、原理到原理的原理，以及可深入的子词与书籍。" />
  </head>
  <body>
    <canvas id="cursor-canvas" aria-hidden="true"></canvas>
    <header class="site-header">
      <div class="nav-shell">
        <a class="wordmark" href="https://zoeimport.github.io/">ZoeImport<span>.</span></a>
        <nav class="primary-nav">
          <a href={`${base}`} aria-current="page">Atlas</a>
          <a href="https://zoeimport.github.io/">主站</a>
          <a href="https://github.com/ZoeImport" rel="me">GitHub ↗</a>
        </nav>
      </div>
    </header>
    <div class="page-shell">
      <header class="page-top">
        <span class="eyebrow">Knowledge Atlas</span>
        <h1>关键词与笔记<em>.</em></h1>
        <p>每个词都有一篇像人写的文章：背景、原理、原理的原理，以及能继续深入的子词和该读的书。</p>
        <div class="search" data-base={base}>
          <input id="search-box" type="search" placeholder="搜索关键词、子词、书籍…" autocomplete="off" aria-label="站内搜索" />
          <span class="hint">Ctrl K</span>
          <div id="search-results" class="search-results"></div>
        </div>
      </header>
      <main>
        {categories.map((cat) => (
          <section class="category reveal">
            <h2>{catIcon[cat] || '📌'} {cat} <span class="count">{keywords.filter((k) => k.category === cat).length} 词</span></h2>
            <div class="card-grid">
              {keywords.filter((k) => k.category === cat).map((k) => {
                const note = noteFor(k.id)
                return (
                  <a class="lcard" href={`${base}keywords/${k.id}/`}>
                    <div class="lcard-head">
                      <span class="card-cat">{catIcon[k.category] || '📌'} {k.category}</span>
                      <span class="lcard-meta">{note ? `${note.angles.length} 角度 · ${note.subTopics.length} 子词` : ''}</span>
                    </div>
                    <h3>{k.title}</h3>
                    <p class="lcard-summary">{k.summary}</p>
                    {note && note.subTopics.length > 0 && (
                      <div class="lcard-chips">
                        {note.subTopics.slice(0, 4).map((s) => <span>{s.name}</span>)}
                        {note.subTopics.length > 4 && <span class="more">+{note.subTopics.length - 4}</span>}
                      </div>
                    )}
                    <div class="card-meta">{k.tags.map((t) => <span class="tag">{t}</span>)}</div>
                  </a>
                )
              })}
            </div>
          </section>
        ))}
      </main>
      <section class="category reveal">
        <h2>书架 <span class="count">{books.filter((b) => b.status !== 'recommended').length} 本</span></h2>
        <div class="bookgrid">
          {books.filter((b) => b.status !== 'recommended').map((b) => (
            <div class="bookcard">
              <h3>{b.title} <span class="status">{b.status === 'reading' ? '在读' : '已读'}</span></h3>
              {b.progress ? <p class="progress">{b.progress}</p> : <p>{b.detail}</p>}
            </div>
          ))}
        </div>
      </section>
      <footer class="site-footer">Knowledge Atlas · 关键词与笔记</footer>
    </div>
    <script is:inline>
      // ---------- 站内搜索 ----------
      (() => {
        const BASE = document.querySelector('.search').dataset.base
        const box = document.getElementById('search-box')
        const panel = document.getElementById('search-results')
        let index = null
        const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))
        const snippet = (text, q) => {
          const i = text.toLowerCase().indexOf(q.toLowerCase())
          if (i < 0) return esc(text.slice(0, 60))
          return esc(text.slice(Math.max(0, i - 18), i)) + '<mark>' + esc(text.slice(i, i + q.length)) + '</mark>' + esc(text.slice(i + q.length, i + q.length + 50))
        }
        fetch(BASE + 'search-index.json').then((r) => r.json()).then((d) => { index = d }).catch(() => {})
        const run = () => {
          const q = box.value.trim()
          if (!q || !index) { panel.innerHTML = ''; panel.classList.remove('open'); return }
          const hits = index.filter((it) => (it.title + it.category + it.tags.join(' ') + it.summary + it.body).toLowerCase().includes(q.toLowerCase())).slice(0, 8)
          panel.innerHTML = hits.length
            ? hits.map((it) => '<a href="' + BASE + 'keywords/' + it.id + '/"><b>' + esc(it.title) + '</b><span class="cat">' + esc(it.category) + '</span><em>' + snippet(it.title + ' ' + it.summary + ' ' + it.body, q) + '</em></a>').join('')
            : '<div class="empty">没有匹配的结果</div>'
          panel.classList.add('open')
        }
        box.addEventListener('input', run)
        box.addEventListener('keydown', (e) => { if (e.key === 'Escape') panel.classList.remove('open') })
        document.addEventListener('click', (e) => { if (!e.target.closest('.search')) panel.classList.remove('open') })
        document.addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); box.focus() } })
      })()
      // ---------- 滚动渐入 ----------
      (() => {
        const els = document.querySelectorAll('.reveal')
        if (!els.length) return
        els.forEach((el) => el.classList.add('js-pending'))
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.classList.add('is-in')); return
        }
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target) }
        }), { threshold: 0.1 })
        els.forEach((el) => io.observe(el))
      })()
      // ---------- 鼠标追踪气泡 ----------
      (() => {
        const cv = document.getElementById('cursor-canvas')
        if (!cv || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
        const ctx = cv.getContext('2d')
        const dpr = Math.min(window.devicePixelRatio || 1, 2)
        let W = 0, H = 0
        const resize = () => { W = window.innerWidth; H = window.innerHeight; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0) }
        resize()
        window.addEventListener('resize', resize)
        const bubbles = []
        const MAX = 40
        let mx = -100, my = -100
        window.addEventListener('mousemove', (e) => {
          mx = e.clientX; my = e.clientY
          if (bubbles.length < MAX) {
            bubbles.push({ x: mx + (Math.random() - 0.5) * 8, y: my, r: 2 + Math.random() * 8, v: 0.35 + Math.random() * 0.6, o: 0.22 + Math.random() * 0.18, sway: Math.random() * Math.PI * 2 })
          }
        })
        let t = 0
        const loop = () => {
          t += 0.02
          ctx.clearRect(0, 0, W, H)
          if (mx > 0) {
            ctx.beginPath(); ctx.arc(mx, my, 4, 0, Math.PI * 2)
            ctx.fillStyle = 'rgba(168,92,60,0.45)'; ctx.fill()
          }
          for (let i = bubbles.length - 1; i >= 0; i--) {
            const b = bubbles[i]
            b.y -= b.v
            b.x += Math.sin(t * 2 + b.sway) * 0.3
            b.o -= 0.004
            if (b.o <= 0) { bubbles.splice(i, 1); continue }
            ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2)
            ctx.fillStyle = 'rgba(168,92,60,' + b.o.toFixed(3) + ')'; ctx.fill()
            ctx.beginPath(); ctx.arc(b.x - b.r * 0.3, b.y - b.r * 0.3, b.r * 0.26, 0, Math.PI * 2)
            ctx.fillStyle = 'rgba(255,255,255,' + (b.o * 0.7).toFixed(3) + ')'; ctx.fill()
          }
          requestAnimationFrame(loop)
        }
        loop()
      })()
    </script>
  </body>
</html>
